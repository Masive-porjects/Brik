# Copiá este archivo a .env.local y completá los valores.
# .env.local está en .gitignore: nunca subas claves al repo.

# --- Agente de interpretación (obligatorio para /voz) ---
GEMINI_API_KEY=
# Opcional: sobreescribe el modelo por defecto (gemini-3.7-flash)
# GEMINI_MODEL=

# --- Voz del agente (opcional) ---
# Mientras esto NO sea "elevenlabs", /voz/speak responde 204 y el navegador
# sintetiza gratis. Ponelo en "elevenlabs" solo para ensayar y para la demo.
VOICE_MODE=browser

ELEVENLABS_API_KEY=
# Sacá estos dos con:  npm run eleven:list -w apps/studio
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL_ID=

# --- Backend de mastering ---
# Producción (Vercel): https://waveai-orchestrator.waveiamusic.workers.dev/api
NEXT_PUBLIC_API_URL=http://localhost:8000/api
