# WAVEAI CLIENT DEMO — audiomind backend environment (template)
# ================================================================
# Copiá estos valores al entorno del servicio Railway (o usalos para
# levantar el backend demo localmente). El backend sin estas variables
# se comporta byte-for-byte igual que antes (prerender "all", sin límite).
#
#   Cómo levantar localmente con demo env (PowerShell):
#     cd apps/audiomind
#     $env:AUDIOMIND_PRERENDER_MODE="on_demand"; ...
#     .\.venv\Scripts\python.exe -m uvicorn audiomind.main:app --port 8000
#
#   O bien:  Copy-Item .env.demo .env   (pydantic-settings lee .env)

# On-demand: la subida termina en "uploaded" con CERO DSP automático.
AUDIOMIND_PRERENDER_MODE=on_demand

# Concurrency global = 1: presets secuenciales, nunca dos pipelines DSP
# simultáneos (ni entre usuarios de la misma instancia demo).
AUDIOMIND_MAX_CONCURRENT_DSP=1

# Límite de duración: 4 minutos / 240 segundos (backend es la autoridad).
AUDIOMIND_DEMO_MAX_DURATION_SECONDS=240

# Límite de archivo: 100 MB cubre un WAV PCM24 44.1k estéreo de 4 min
# (≈63.5 MB) con margen; MP3 y WAV 16-bit quedan holgados. El default
# no-demo sigue siendo 50 MB.
AUDIOMIND_MAX_FILE_SIZE_MB=100

# TTL de sesión: 60 minutos sin actividad → el janitor limpia original +
# masters generados + cache de la sesión.
AUDIOMIND_SESSION_TTL_MINUTES=60