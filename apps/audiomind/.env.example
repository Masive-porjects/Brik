# AudioMind Production Environment Template
# =========================================
# Copy this to .env and fill in your values, or set these as environment
# variables in Railway/Vercel/Supabase dashboard.
#
# The backend uses pydantic-settings with extra="forbid" - every key here
# MUST have a corresponding field in config.py. Unknown keys will crash
# startup with ValidationError. This is intentional.

# ── Core Application ─────────────────────────────────────────────────
AUDIOMIND_APP_NAME=AudioMind
AUDIOMIND_DEBUG=false

# ── Server ───────────────────────────────────────────────────────────
AUDIOMIND_HOST=0.0.0.0
AUDIOMIND_PORT=8000

# ── CORS ─────────────────────────────────────────────────────────────
# Comma-separated origins. The regex below covers any *.vercel.app for preview deployments.
AUDIOMIND_CORS_ORIGINS=https://studio-production-f546.up.railway.app,https://wave-ia-studio.vercel.app
AUDIOMIND_CORS_ORIGIN_REGEX=https://.*\.vercel\.app

# ── File Storage ─────────────────────────────────────────────────────
AUDIOMIND_MAX_FILE_SIZE_MB=100

# ── Processing ───────────────────────────────────────────────────────
AUDIOMIND_TARGET_LUFS=-14.0
AUDIOMIND_SAMPLE_RATE=44100

# ── Demo Mode (client-facing demo deployment) ────────────────────────
# On-demand: upload completes with ZERO automatic DSP. Presets render on click.
AUDIOMIND_PRERENDER_MODE=on_demand
# Global concurrency = 1: sequential presets, never two DSP pipelines at once
AUDIOMIND_MAX_CONCURRENT_DSP=1
# 4-minute / 240-second duration cap (backend is the authority)
AUDIOMIND_DEMO_MAX_DURATION_SECONDS=240
# 100 MB covers 4-min PCM24 44.1k stereo (~63.5 MB) with headroom
AUDIOMIND_MAX_FILE_SIZE_MB=100
# Session TTL: 60 minutes idle -> janitor cleans original + masters + session cache
AUDIOMIND_SESSION_TTL_MINUTES=60

# ── Session Store Backend ────────────────────────────────────────────
# "auto" (default): Supabase when configured AND table probes clean, file mirror otherwise
# "supabase": force Supabase, no fallback (fails if unavailable)
# "file": never touch the network, use uploads/sessions.json only
AUDIOMIND_SESSION_STORE_BACKEND=auto

# ── Supabase (Postgres + Auth + Storage) ────────────────────────────
# Required for: durable sessions, job store, project flow, RLS auth
AUDIOMIND_SUPABASE_URL=https://your-project.supabase.co
AUDIOMIND_SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
AUDIOMIND_SUPABASE_ANON_KEY=your-anon-key
# Storage buckets for originals/masters (created by migrations)
AUDIOMIND_SUPABASE_ORIGINALS_BUCKET=audio-originals
AUDIOMIND_SUPABASE_MASTERS_BUCKET=audio-masters

# ── Cloudflare R2 (S3-compatible object storage) ─────────────────────
# REQUIRED - no defaults. Unconfigured deployment must fail loudly.
# Use AUDIOMIND_R2_* prefix (takes precedence) or CLOUDFLARE_R2_* / bare R2_*
AUDIOMIND_R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
AUDIOMIND_R2_ACCESS_KEY_ID=your-access-key
AUDIOMIND_R2_SECRET_ACCESS_KEY=your-secret-key
AUDIOMIND_R2_BUCKET=your-bucket-name
# Optional public base URL for shareable links (r2.dev or custom domain)
AUDIOMIND_R2_PUBLIC_URL=https://pub-<bucket-id>.r2.dev

# ── Job Store ────────────────────────────────────────────────────────
# Lease seconds for BackgroundTask heartbeat (orphan detection)
AUDIOMIND_JOB_LEASE_SECONDS=900

# ── Demucs Stem Separation ───────────────────────────────────────────
# fp16weights = ~158 MiB (baked in Docker image), fp32 = ~302 MiB
AUDIOMIND_DEMUCS_PRECISION=fp16weights
# Isolate in child process so memory is reclaimed on exit (prevents OOM)
AUDIOMIND_DEMUCS_ISOLATED=true
# Thread cap for child process (4 keeps cores busy without multiplicative arenas)
AUDIOMIND_DEMUCS_THREADS=4
# Generous timeout: 30s probe took 227s on 8 vCPU without GPU
AUDIOMIND_DEMUCS_TIMEOUT_SECONDS=1800

# ── LLM Transport (Agentic Loop) ─────────────────────────────────────
# Provider: gemini | openai | deepseek | ollama | anthropic
AUDIOMIND_LLM_PROVIDER=gemini
# Model name (empty = adapter default)
AUDIOMIND_AGENT_MODEL_NAME=gemini-2.5-flash
# API key for non-Gemini providers
AUDIOMIND_LLM_API_KEY=
# Base URL override (empty = adapter default)
AUDIOMIND_LLM_BASE_URL=
# Gemini API key (required for Gemini provider)
AUDIOMIND_GEMINI_API_KEY=your-gemini-api-key

# ── License ──────────────────────────────────────────────────────────
AUDIOMIND_LICENSE_KEY=